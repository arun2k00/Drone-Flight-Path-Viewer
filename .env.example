# --- Database (SQLite file; relative to the project root) ---
DATABASE_URL="file:./storage/app.db"

# --- Storage ---
STORAGE_PATH=./storage
# Scratch space for exports. Empty = <os tmpdir>/drone-telemetry
TEMP_PATH=

# --- Upload limits (MiB) ---
MAX_VIDEO_SIZE_MB=4096
MAX_SRT_SIZE_MB=50
MAX_LOGO_SIZE_MB=5
UPLOAD_CHUNK_SIZE_MB=32

# --- FFmpeg ---
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# --- Editor flight map (MapLibre, interactive viewing) ---
# Empty = built-in OpenStreetMap raster style (attribution shown).
NEXT_PUBLIC_MAP_STYLE_URL=
# Empty = SATELLITE toggle disabled (falls back to the map style).
NEXT_PUBLIC_SATELLITE_STYLE_URL=

# --- Burned-in mini-map basemap (preview + export) ---
# Leave empty unless your tile provider's terms allow server-side rendering into videos.
# Do NOT use tile.openstreetmap.org here (its policy forbids offline/bulk use).
# Template placeholders: {z} {x} {y}, optional {s} (a/b/c) and {r} (removed).
OVERLAY_MAP_TILE_URL=
OVERLAY_MAP_TILE_ATTRIBUTION=
OVERLAY_SATELLITE_TILE_URL=
OVERLAY_SATELLITE_TILE_ATTRIBUTION=
MAP_TILE_USER_AGENT="Aeroxpress/1.0 (self-hosted)"

# --- Diagnostics & logging ---
# Default: true in development, false in production
ENABLE_DIAGNOSTICS=
LOG_LEVEL=info

# --- Accounts & email ---
# Public URL of this site; used in emails and client share links.
APP_URL=http://localhost:3470
# Only this address becomes admin (set it in production). Empty = the first account is the admin.
ADMIN_EMAIL=
# SMTP. Empty SMTP_HOST = emails are saved as HTML files in <STORAGE_PATH>/outbox (dev mode).
SMTP_HOST=
SMTP_PORT=587
# Empty = true for port 465, false otherwise
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Aeroxpress <no-reply@example.com>"

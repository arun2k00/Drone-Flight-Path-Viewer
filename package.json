{
  "name": "aeroxpress",
  "version": "1.0.0",
  "private": true,
  "description": "Drone video with its flight data, ready to share: DJI MP4 + SRT flight viewer, client share links and telemetry overlay export.",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/arun2k00/Drone-Flight-Path-Viewer.git" },
  "scripts": {
    "dev": "next dev -p 3470",
    "build": "prisma generate && next build",
    "start": "next start -p 3470",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "e2e": "tsx scripts/e2e-export.mts",
    "fixtures": "tsx scripts/gen-fixtures.mts",
    "srt:inspect": "tsx scripts/srt-inspect.mts",
    "verify": "npm run lint && npm run typecheck && npm test && npm run test:integration",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.9",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "@resvg/resvg-js": "2.6.2",
    "@tanstack/react-virtual": "3.14.12",
    "better-sqlite3": "13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "dotenv": "17.4.2",
    "lucide-react": "^1.46.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.5",
    "next-themes": "^0.4.6",
    "nodemailer": "10.0.10",
    "prisma": "7.10.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.12.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.6.4",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@ibm/plex-mono": "2.5.0",
    "@ibm/plex-sans": "1.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.4",
    "@types/nodemailer": "8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "5.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "5.0.0"
  }
}
